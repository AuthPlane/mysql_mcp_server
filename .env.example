MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_username
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=your_database
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL
MYSQL_CONNECT_TIMEOUT=10

# Compatibility (Issue #31, for MySQL 5.7)
MYSQL_AUTH_PLUGIN=mysql_native_password
MYSQL_USE_PURE=false
MYSQL_RAISE_ON_WARNINGS=false
# Read/write separation (recommended when using the SSE transport)
# A SELECT-only MySQL account. The read tools connect as this account, so MySQL
# itself refuses writes. Grants are checked at startup; the server refuses to
# start if this account can write.
#   CREATE USER 'mcp_ro'@'%' IDENTIFIED BY '...';
#   GRANT SELECT ON your_database.* TO 'mcp_ro'@'%';
MYSQL_RO_USER=
MYSQL_RO_PASSWORD=
MYSQL_MAX_ROWS=1000
MYSQL_STATEMENT_TIMEOUT_MS=30000

# OAuth 2.1 authentication (SSE transport only)
# Requires: pip install mysql_mcp_server[auth]
# Full reference: AUTHENTICATION.md
# Leave MCP_AUTH_MODE unset or 'none' to keep the current behaviour unchanged.
#
# The values below are what any OAuth 2.1 authorization server gives you. The
# verifier that ships is Authplane's; see AUTHENTICATION.md for what adopting a
# different one involves, and for what has and has not been tested.
MCP_AUTH_MODE=none
MCP_OAUTH_ISSUER=
MCP_OAUTH_RESOURCE=
# Local development against an http:// authorization server (e.g. localhost):
# required to boot at all, not merely to silence a warning. Without it the SDK's
# SSRF guard refuses to fetch discovery/JWKS from a non-https, non-public host
# and startup fails with a misleading "Could not reach the authorization server"
# error.
MCP_OAUTH_DEV_MODE=false
MYSQL_SCOPE_READ=mysql:read
MYSQL_SCOPE_WRITE=mysql:write
MCP_AUTH_BIND_SESSION=true
MCP_AUTH_AUDIT=true
# Optional: also write audit records to this file, one JSON object per line.
# Without it they go to stderr, interleaved with the access log.
MCP_AUTH_AUDIT_FILE=
MCP_AUTH_DPOP=off
MCP_AUTH_REVOCATION_CHECK=false
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_AUTH_MAX_AUTH_FAILURES=0
MCP_OAUTH_CLOCK_SKEW_SECONDS=30
MCP_OAUTH_ALLOWED_ALGORITHMS=ES256,RS256
